#!/usr/bin/env bash
set -euo pipefail

# Determine script directory - use installed location if libraries not found locally
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -d "$SCRIPT_DIR/lib" ]]; then
    # Libraries not found locally, use installed location
    SCRIPT_DIR="$HOME/.local/lib/milhouse"
fi

# Export repo dir so agent.sh can find prompt.md
export MILHOUSE_REPO_DIR="$SCRIPT_DIR"

# Load libraries
source "$SCRIPT_DIR/lib/agent.sh"
source "$SCRIPT_DIR/lib/autorun.sh"
source "$SCRIPT_DIR/lib/sync.sh"
source "$SCRIPT_DIR/lib/qmd.sh"
source "$SCRIPT_DIR/lib/ruby.sh"

VERSION="2.0.1"

show_help() {
    cat << EOF
Milhouse - Autonomous AI Agent System

Usage:
  milhouse run [turns]                     Run milhouse agent (default: 25 turns)
  milhouse run --tool <tool> [turns]       Run with specific tool (claude|copilot|opencode|amp)
  milhouse run --verbose [turns]           Run with verbose/streaming output (default)
  milhouse run --quiet [turns]             Run with minimal output

  milhouse autorun start            Start autorunner daemon
  milhouse autorun stop             Stop autorunner daemon
  milhouse autorun restart          Restart autorunner daemon
  milhouse autorun status           Check autorunner status
  milhouse autorun logs             View autorunner logs
  milhouse autorun watch            Watch autorunner logs in real-time
  milhouse autorun schedule         Show/edit schedule
  milhouse autorun config [edit]    View or edit configuration
  milhouse autorun test             Dry run (find PRDs, don't execute)

  milhouse sync                     Sync all milhouse instances in ~/dev
  milhouse qmd setup                Set up qmd for current project
  milhouse qmd update               Update qmd index
  milhouse install [project]        Install milhouse into project

  milhouse ruby setup               Install Ruby/Rails skills and MCP servers
  milhouse ruby status              Check Ruby/Rails installation status
  milhouse ruby help                Show Ruby/Rails help

  milhouse update                   Update milhouse from repository
  milhouse version                  Show version
  milhouse help                     Show this help

Examples:
  milhouse run 15                   Run for 15 turns (verbose output)
  milhouse run --quiet 10           Run for 10 turns (minimal output)
  milhouse run --tool copilot       Run with GitHub Copilot (verbose)
  milhouse run --tool claude --quiet Run with Claude (quiet mode)
  milhouse run --tool opencode      Run with OpenCode
  milhouse run --tool amp           Run with AMP
  milhouse autorun start            Start background automation
  milhouse autorun config           View configuration
  milhouse autorun config edit      Edit schedule configuration
  milhouse sync                     Update all instances
  milhouse qmd setup                Configure qmd for this project
  milhouse ruby setup               Set up Ruby/Rails skills and MCP servers

EOF
}

# Main command routing
main() {
    case "${1:-}" in
        run)
            shift
            run_agent "$@"
            ;;
        autorun)
            shift
            case "${1:-}" in
                start) autorun_start ;;
                stop) autorun_stop ;;
                restart) autorun_restart ;;
                status) autorun_status ;;
                logs) autorun_logs ;;
                watch) autorun_watch ;;
                schedule) autorun_schedule ;;
                config) shift; autorun_config "$@" ;;
                test) autorun_test ;;
                daemon) autorun_daemon ;;
                *) echo "Unknown autorun command: ${1:-}"; show_help; exit 1 ;;
            esac
            ;;
        sync)
            shift
            sync_instances "$@"
            ;;
        qmd)
            shift
            case "${1:-}" in
                setup) qmd_setup ;;
                update) qmd_update ;;
                *) echo "Unknown qmd command: ${1:-}"; show_help; exit 1 ;;
            esac
            ;;
        install)
            shift
            install_milhouse "$@"
            ;;
        ruby)
            shift
            case "${1:-}" in
                setup) ruby_setup ;;
                status) ruby_status ;;
                skills) ruby_install_skills ;;
                mcp) ruby_install_mcp_servers ;;
                help) ruby_help ;;
                *) ruby_help ;;
            esac
            ;;
        update)
            # Run update script from the git repository
            UPDATE_SCRIPT="$HOME/Dev/milhouse/update.sh"
            if [[ -f "$UPDATE_SCRIPT" ]]; then
                bash "$UPDATE_SCRIPT"
            else
                echo "Error: update.sh not found at $UPDATE_SCRIPT"
                echo "Please ensure the milhouse repository is at ~/Dev/milhouse/"
                exit 1
            fi
            ;;
        version)
            echo "Milhouse version $VERSION"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            echo "Unknown command: ${1:-}"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
